NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Data Providers (Strict Free-Tier Conservation)
# 1. Football-Data.org: Free tier API key (Standings, team form, goal averages)
# Get key at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# 2. The Odds API: Free tier API key (500 requests/month, EU/UK soccer 1X2 & totals)
# Get key at: https://the-odds-api.com/
THE_ODDS_API_KEY=your_the_odds_api_key_here

# Protected Background Sync Secret
# Set a custom token to protect /api/sync from unauthorized triggers
CRON_SECRET=oddsmatrix_secure_cron_secret_key_2026
